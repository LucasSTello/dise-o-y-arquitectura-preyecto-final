  "description": "Backend de Ecommerce con Node.js, Express, MongoDB, Mongoose, Passport JWT, Nodemailer y arquitectura en capas con Repository Pattern",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "create-admin": "node src/scripts/create-admin.js",
